# Bu dosya bir ŞABLONDUR. Kopyalayıp adını ".env" yapın ve değerleri doldurun.
# ".env" dosyası GitHub'a gönderilmez, böylece şifreler gizli kalır.

# Sunucunun çalışacağı kapı (port) numarası
PORT=3000

# Odalar kaç saat hareketsiz kalınca silinsin
ODA_OMRU_SAAT=3

# İnternette yayınlarken sitenin adresi (QR kodlar bu adresi gösterir).
# Kendi bilgisayarınızda çalışırken boş bırakın; adres otomatik bulunur.
PUBLIC_URL=
